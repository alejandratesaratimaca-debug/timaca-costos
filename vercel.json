{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/dotacion/:path*",
      "destination": "https://sigma-dotacion.vercel.app/dotacion/:path*"
    },
    {
      "source": "/dotacion",
      "destination": "https://sigma-dotacion.vercel.app/dotacion/"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
